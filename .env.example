# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Prefer publishable key; if RLS insert errors persist, also set legacy anon JWT:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   (legacy anon key — optional fallback)
# Server-only: bypasses RLS for /api/waitlist and /api/contact inserts (never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: Resend notification when contact form is submitted
RESEND_API_KEY=
RESEND_FROM=Sage <onboarding@resend.dev>
CONTACT_NOTIFY_EMAIL=hello@sage.app
